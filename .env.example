# Server Configuration
HOST=0.0.0.0
PORT=28200

# Workspace Configuration
WORKSPACE_ROOT=./workspace
MAX_UPLOAD_BYTES=209715200
TASK_TTL_SECONDS=3600

# FFmpeg Configuration
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# 硬件加速：auto（探测 NVIDIA NVENC，不可用回退 CPU）| cuda | none
FFMPEG_HW_ACCEL=cuda
# NVENC 画质（-cq，0-51，越小越好）；CPU 模式忽略
FFMPEG_ENCODER_QUALITY=23
# NVENC 预设 p1-p7；CPU 模式忽略
FFMPEG_ENCODER_PRESET=p4

# 任务队列：并发 worker 数（同时处理的视频数，每视频占 1 路 NVENC）
QUEUE_WORKER_COUNT=4
# 等待队列容量；满载时 POST 返回 503，避免无限占用磁盘与内存
QUEUE_MAX_SIZE=20
# 失败任务最大重试次数
QUEUE_MAX_RETRIES=1
# 停机时等待在途任务完成的时间
QUEUE_SHUTDOWN_GRACE_SECONDS=30

# Scene Detection Parameters
SCENE_ADAPTIVE_THRESHOLD=3.0
SCENE_MIN_LENGTH_SECONDS=0.8
SCENE_WINDOW_WIDTH=2
SCENE_MIN_CONTENT_VALUE=15.0
